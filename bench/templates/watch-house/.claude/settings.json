{
  "statusLine": { "type": "command", "command": "watch-status --short" },
  "permissions": {
    "allow": ["Bash(git status)", "Read(./rota/**)"],
    "deny": ["Read(./secrets/**)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-rota.sh", "timeout": 10 }]
      }
    ]
  }
}
